# Server
PORT=8080
ENV=development                         # development | production

# PostgreSQL
DATABASE_URL=postgres://shakemeal:secret@localhost:5432/shakemeal?sslmode=disable

# Google Places API
GOOGLE_PLACES_API_KEY=your_key_here     # https://console.cloud.google.com

# JWT
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars

# Apple Sign In
APPLE_BUNDLE_ID=com.shakemeal.app   # must match your Xcode bundle ID

# Places cache TTL (minutes)
PLACES_CACHE_TTL_MINUTES=10
